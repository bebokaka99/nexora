{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to Backend (Node.js Debugger)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "sourceMaps": true,
      "localRoot": "${workspaceFolder}/backend",
      "remoteRoot": "/app"
    },
    {
      "name": "Attach to Frontend (Chrome / Edge Debugger)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "Fullstack Debugging (Backend + Frontend)",
      "configurations": [
        "Attach to Backend (Node.js Debugger)",
        "Attach to Frontend (Chrome / Edge Debugger)"
      ]
    }
  ]
}
