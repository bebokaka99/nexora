# NEXORA — Mẫu biến môi trường (.env.example)
#
# Cách dùng:
#   cp .env.example .env
#   # rồi sửa các giá trị cho đúng môi trường của bạn.
#
# ⚠️ CHỈ CHỨA GIÁ TRỊ MẪU — KHÔNG BAO GIỜ ghi secret thật vào file này.
# File `.env` thật đã nằm trong `.gitignore` và không được commit.
# Các giá trị mặc định bên dưới CHỈ DÙNG CHO DEV LOCAL (docker compose).

# ==============================================================================
# PostgreSQL — dùng chung cho backend + docker-compose service `postgres`
# ==============================================================================
POSTGRES_USER=nexora
POSTGRES_PASSWORD=nexora_dev_only
POSTGRES_DB=nexora

# ==============================================================================
# Backend (NestJS) — BẮT BUỘC
# ==============================================================================
# Chuỗi kết nối PostgreSQL. Backend fail-fast (TASK-009): thiếu biến này thì
# backend từ chối khởi động, không chạy bằng dữ liệu giả.
# Khi chạy bằng docker compose, host là tên service `postgres`.
DATABASE_URL=postgresql://nexora:nexora_dev_only@postgres:5432/nexora
# Khi chạy backend trực tiếp trên máy (không qua compose), dùng:
# DATABASE_URL=postgresql://nexora:nexora_dev_only@localhost:5432/nexora

# Redis — CHƯA DÙNG TRONG CODE (dành cho BullMQ, theo kế hoạch Phase 06.5).
# Service `redis` trong docker-compose đã chạy sẵn để dùng sau.
REDIS_URL=redis://redis:6379

# JWT — BẮT BUỘC ở production. Dev có thể để mặc định mẫu bên dưới.
# ⚠️ Đổi ngay khi deploy thật. Không dùng các giá trị mẫu này ở production.
JWT_SECRET=change-me-dev-only-jwt-secret
JWT_REFRESH_SECRET=change-me-dev-only-jwt-refresh-secret

# Cổng backend (mặc định trong backend/src/main.ts là 4000).
PORT=4000
# Tiền tố API (mặc định: api/v1).
API_PREFIX=api/v1
# CORS: origin của frontend (mặc định: http://localhost:3000).
CORS_ORIGIN=http://localhost:3000
# Đường dẫn Swagger (mặc định: docs → http://localhost:4000/docs).
SWAGGER_PATH=docs
# Môi trường Node: development | production.
NODE_ENV=development

# ==============================================================================
# Seed database (database/prisma/seed.ts) — BẮT BUỘC khi chạy seed
# ==============================================================================
# Mật khẩu cho tài khoản admin seed (admin@nexora.vn). Không có biến này thì
# seed dừng và báo lỗi. Đặt mật khẩu mạnh, không commit giá trị thật.
SEED_ADMIN_PASSWORD=change-me-dev-only-seed-password

# ==============================================================================
# Frontend (Next.js) — BẮT BUỘC
# ==============================================================================
# URL API mà trình duyệt gọi tới. Biến NEXT_PUBLIC_* được nhúng vào bundle
# lúc `next build`, nên khi đổi giá trị này phải build lại frontend.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ==============================================================================
# Tích hợp sàn TMĐT — CHƯA TRIỂN KHAI, CHƯA DÙNG TRONG CODE
# ==============================================================================
# Hiện code chỉ có enum kênh (SHOPEE / TIKTOK_SHOP) trong DTO, chưa có client
# gọi API sàn thật (spike ở TASK-013). Giữ placeholder để khi triển khai thì
# khai báo tại đây, không hardcode key vào source.
# SHOPEE_PARTNER_ID=
# SHOPEE_PARTNER_KEY=
# TIKTOK_SHOP_APP_KEY=
# TIKTOK_SHOP_APP_SECRET=
