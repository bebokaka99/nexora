generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// I. SAAS & TENANT CORE
// =============================================================================

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  TERMINATED
}

model Tenant {
  id           String        @id @default(uuid())
  name         String        @db.VarChar(255)
  slug         String        @unique @db.VarChar(100)
  status       TenantStatus  @default(TRIAL)
  planId       String?       @map("plan_id") @db.VarChar(36)
  trialEndsAt  DateTime?     @map("trial_ends_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  plan         SubscriptionPlan? @relation(fields: [planId], references: [id])
  users        User[]
  stores       Store[]
  warehouses   Warehouse[]
  products     Product[]
  orders       Order[]
  customers    Customer[]
  channels     ChannelConnection[]
  stockTransfers StockTransfer[]
  inventoryTransactions InventoryTransaction[]

  @@map("tenants")
}

model SubscriptionPlan {
  id             String   @id @default(uuid())
  name           String   @db.VarChar(100)
  code           String   @unique @db.VarChar(50)
  maxStores      Int      @default(1) @map("max_stores")
  maxWarehouses  Int      @default(1) @map("max_warehouses")
  maxUsers       Int      @default(3) @map("max_users")
  maxChannels    Int      @default(1) @map("max_channels")
  priceMonthly   Decimal  @default(0) @map("price_monthly") @db.Decimal(12, 2)
  priceYearly    Decimal  @default(0) @map("price_yearly") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenants        Tenant[]

  @@map("subscription_plans")
}

// =============================================================================
// II. IDENTITY & ACCESS MANAGEMENT (RBAC)
// =============================================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model User {
  id           String     @id @default(uuid())
  tenantId     String?    @map("tenant_id") @db.VarChar(36)
  email        String     @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  fullName     String     @map("full_name") @db.VarChar(150)
  phoneNumber  String?    @map("phone_number") @db.VarChar(20)
  status       UserStatus @default(ACTIVE)
  storeId      String?    @map("store_id") @db.VarChar(36)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  tenant       Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store        Store?     @relation(fields: [storeId], references: [id], onDelete: SetNull)
  roles        UserRole[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Role {
  id           String           @id @default(uuid())
  tenantId     String?          @map("tenant_id") @db.VarChar(36)
  code         String           @db.VarChar(50)
  name         String           @db.VarChar(100)
  description  String?
  isSystem     Boolean          @default(false) @map("is_system")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  users        UserRole[]
  permissions  RolePermission[]

  @@unique([tenantId, code])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique @db.VarChar(100)
  module      String           @db.VarChar(50)
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")

  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.VarChar(36)
  roleId    String   @map("role_id") @db.VarChar(36)
  assignedAt DateTime @default(now()) @map("assigned_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.VarChar(36)
  permissionId String     @map("permission_id") @db.VarChar(36)

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// =============================================================================
// III. STORES & WAREHOUSES
// =============================================================================

enum WarehouseType {
  CENTRAL
  STORE_ATTACHED
}

model Store {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id") @db.VarChar(36)
  name               String    @db.VarChar(150)
  code               String    @db.VarChar(50)
  address            String    @db.Text
  phoneNumber        String?   @map("phone_number") @db.VarChar(20)
  defaultWarehouseId String?   @map("default_warehouse_id") @db.VarChar(36)
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tenant             Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defaultWarehouse   Warehouse? @relation("StoreDefaultWarehouse", fields: [defaultWarehouseId], references: [id])
  users              User[]
  orders             Order[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("stores")
}

model Warehouse {
  id          String        @id @default(uuid())
  tenantId    String        @map("tenant_id") @db.VarChar(36)
  name        String        @db.VarChar(150)
  code        String        @db.VarChar(50)
  type        WarehouseType @default(STORE_ATTACHED)
  address     String?       @db.Text
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stores      Store[]       @relation("StoreDefaultWarehouse")
  inventories Inventory[]
  orders      Order[]
  transfersFrom StockTransfer[] @relation("TransfersFrom")
  transfersTo   StockTransfer[] @relation("TransfersTo")
  inventoryTransactions InventoryTransaction[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("warehouses")
}

// =============================================================================
// IV. PRODUCTS & INVENTORY
// =============================================================================

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Category {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id") @db.VarChar(36)
  name      String    @db.VarChar(100)
  slug      String    @db.VarChar(120)
  createdAt DateTime  @default(now()) @map("created_at")

  products  Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("categories")
}

model Product {
  id          String           @id @default(uuid())
  tenantId    String           @map("tenant_id") @db.VarChar(36)
  categoryId  String?          @map("category_id") @db.VarChar(36)
  name        String           @db.VarChar(255)
  slug        String           @db.VarChar(255)
  brand       String?          @db.VarChar(100)
  description String?          @db.Text
  status      ProductStatus    @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants    ProductVariant[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@map("products")
}

model ProductVariant {
  id           String      @id @default(uuid())
  tenantId     String      @map("tenant_id") @db.VarChar(36)
  productId    String      @map("product_id") @db.VarChar(36)
  sku          String      @db.VarChar(100)
  barcode      String?     @db.VarChar(100)
  variantName  String      @map("variant_name") @db.VarChar(150)
  costPrice    Decimal     @default(0) @map("cost_price") @db.Decimal(12, 2)
  sellingPrice Decimal     @default(0) @map("selling_price") @db.Decimal(12, 2)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventories  Inventory[]
  orderItems   OrderItem[]
  transferItems StockTransferItem[]
  inventoryTransactions InventoryTransaction[]

  @@unique([tenantId, sku])
  @@index([tenantId, sku])
  @@index([tenantId, barcode])
  @@map("product_variants")
}

model Inventory {
  id           String         @id @default(uuid())
  tenantId     String         @map("tenant_id") @db.VarChar(36)
  warehouseId  String         @map("warehouse_id") @db.VarChar(36)
  variantId    String         @map("variant_id") @db.VarChar(36)
  onHandQty    Int            @default(0) @map("on_hand_qty")
  committedQty Int            @default(0) @map("committed_qty")
  availableQty Int            @default(0) @map("available_qty")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  warehouse    Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, warehouseId, variantId])
  @@index([tenantId, warehouseId])
  @@map("inventories")
}

enum StockTransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum InventoryTransactionType {
  RECEIPT
  TRANSFER_OUT
  TRANSFER_IN
  POS_SALE
  COMMITTED_RESERVE
  COMMITTED_RELEASE
  ADJUSTMENT
}

model StockTransfer {
  id                String              @id @default(uuid())
  tenantId          String              @map("tenant_id") @db.VarChar(36)
  transferNumber    String              @map("transfer_number") @db.VarChar(50)
  sourceWarehouseId String              @map("source_warehouse_id") @db.VarChar(36)
  targetWarehouseId String              @map("target_warehouse_id") @db.VarChar(36)
  status            StockTransferStatus @default(PENDING)
  notes             String?             @db.Text
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceWarehouse Warehouse           @relation("TransfersFrom", fields: [sourceWarehouseId], references: [id])
  targetWarehouse Warehouse           @relation("TransfersTo", fields: [targetWarehouseId], references: [id])
  items           StockTransferItem[]

  @@unique([tenantId, transferNumber])
  @@index([tenantId, status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id         String         @id @default(uuid())
  transferId String         @map("transfer_id") @db.VarChar(36)
  variantId  String         @map("variant_id") @db.VarChar(36)
  quantity   Int

  transfer   StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("stock_transfer_items")
}

model InventoryTransaction {
  id            String                   @id @default(uuid())
  tenantId      String                   @map("tenant_id") @db.VarChar(36)
  warehouseId   String                   @map("warehouse_id") @db.VarChar(36)
  variantId     String                   @map("variant_id") @db.VarChar(36)
  type          InventoryTransactionType
  quantity      Int
  balanceOnHand Int                      @map("balance_on_hand")
  referenceId   String?                  @map("reference_id") @db.VarChar(100)
  note          String?                  @db.Text
  createdAt     DateTime                 @default(now()) @map("created_at")

  tenant        Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse     Warehouse                @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variant       ProductVariant           @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([tenantId, warehouseId, variantId])
  @@index([tenantId, createdAt])
  @@map("inventory_transactions")
}

// =============================================================================
// V. ORDERS & OMNICHANNEL
// =============================================================================

enum ChannelType {
  POS
  SHOPEE
  TIKTOK_SHOP
  FACEBOOK
  MANUAL
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model Order {
  id              String         @id @default(uuid())
  tenantId        String         @map("tenant_id") @db.VarChar(36)
  orderNumber     String         @map("order_number") @db.VarChar(50)
  channelType     ChannelType    @default(POS) @map("channel_type")
  externalOrderId String?        @map("external_order_id") @db.VarChar(100)
  storeId         String?        @map("store_id") @db.VarChar(36)
  warehouseId     String?        @map("warehouse_id") @db.VarChar(36)
  customerId      String?        @map("customer_id") @db.VarChar(36)
  subtotal        Decimal        @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal        @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount     Decimal        @default(0) @map("total_amount") @db.Decimal(12, 2)
  status          OrderStatus    @default(PENDING)
  paymentStatus   PaymentStatus  @default(UNPAID) @map("payment_status")
  paymentMethod   String?        @map("payment_method") @db.VarChar(50)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store           Store?         @relation(fields: [storeId], references: [id], onDelete: SetNull)
  warehouse       Warehouse?     @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  customer        Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items           OrderItem[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("orders")
}

model OrderItem {
  id          String         @id @default(uuid())
  tenantId    String         @map("tenant_id") @db.VarChar(36)
  orderId     String         @map("order_id") @db.VarChar(36)
  variantId   String         @map("variant_id") @db.VarChar(36)
  productName String         @map("product_name") @db.VarChar(255)
  sku         String         @db.VarChar(100)
  quantity    Int            @default(1)
  unitPrice   Decimal        @default(0) @map("unit_price") @db.Decimal(12, 2)
  subtotal    Decimal        @default(0) @db.Decimal(12, 2)

  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([tenantId, orderId])
  @@map("order_items")
}

model Customer {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id") @db.VarChar(36)
  fullName    String   @map("full_name") @db.VarChar(150)
  phoneNumber String?  @map("phone_number") @db.VarChar(20)
  address     String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@unique([tenantId, phoneNumber])
  @@index([tenantId])
  @@map("customers")
}

model ChannelConnection {
  id          String      @id @default(uuid())
  tenantId    String      @map("tenant_id") @db.VarChar(36)
  channelType ChannelType @map("channel_type")
  accountName String      @map("account_name") @db.VarChar(150)
  accountId   String      @map("account_id") @db.VarChar(100)
  status      String      @default("CONNECTED") @db.VarChar(30)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, channelType, accountId])
  @@index([tenantId])
  @@map("channel_connections")
}
